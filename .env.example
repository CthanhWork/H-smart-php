# H-Smart Docker Environment Configuration
# Copy this file to .env and adjust the values

# Database password (required)
# Generate a secure password: openssl rand -hex 32
DB_PASSWORD=your-secure-database-password-here

# Application URLs (adjust for production)
APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174

# Ports (change if default ports are in use)
BACKEND_PORT=127.0.0.1:8001
FRONTEND_PORT=127.0.0.1:5174
PHPMYADMIN_PORT=127.0.0.1:8082
MAILPIT_PORT=127.0.0.1:8026

# Mail configuration (for production email sending)
# Leave commented to use Mailpit for testing
#MAIL_MAILER=smtp
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USERNAME=your-email@gmail.com
#MAIL_PASSWORD=your-app-password
#MAIL_ENCRYPTION=tls
#MAIL_FROM_ADDRESS=noreply@yourdomain.com
#MAIL_FROM_NAME=H-Smart

# For testing, use Mailpit (default)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@hsmart.local

# Optional OpenAI-compatible model for grounded assistant answers.
# Without these settings, the assistant returns relevant approved excerpts with citations.
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=

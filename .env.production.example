# Example production environment variables
# Copy this to .env.production and fill in your actual values

# Docker Hub username (for pulling images)
DOCKERHUB_USER=yourusername
VERSION=v0.2.0

# Database
DB_PASSWORD=change_this_to_secure_password_min_32_chars

# Application
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# JWT Secret (generate: openssl rand -base64 64)
JWT_SECRET=change_this_to_random_64_char_secret

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com

# Optional: Redis (if used in future)
# REDIS_HOST=redis
# REDIS_PASSWORD=
# REDIS_PORT=6379

# Optional: Elasticsearch (if used in future)
# ELASTICSEARCH_HOST=elasticsearch
# ELASTICSEARCH_PORT=9200

# Gemini-compatible model for chatbot and product-description generation.
# Replace with your provider endpoint/key/model if using a different OpenAI-compatible service.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=replace_with_gemini_api_key
AI_CHAT_MODEL=gemini-2.5-flash

# VNPay production merchant account (configure callback URLs in the merchant portal too).
VNPAY_TMN_CODE=your-vnpay-merchant-code
VNPAY_HASH_SECRET=replace_with_vnpay_hash_secret
VNPAY_PAY_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_RETURN_URL=https://your-domain.com/api/v1/payments/vnpay/return
VNPAY_IPN_URL=https://your-domain.com/api/v1/payments/vnpay/ipn
VNPAY_RESULT_REDIRECT_URL=https://your-domain.com/payment-result
VNPAY_SANDBOX_RETURN_FALLBACK=false
